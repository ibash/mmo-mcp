# Dungeon Crawler MCP Environment Variables
# Copy this file to .env and update with your values

# Anthropic API key for AI agent effects (required for 'do' action)
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Persistence mode: "disk" for local JSON files, "postgres" for PostgreSQL
# Default: disk
PERSIST_MODE=disk

# PostgreSQL connection string (required when PERSIST_MODE=postgres)
# Format: postgresql://username:password@host:port/database
# DATABASE_URL=postgresql://user:password@localhost:5432/dungeon_crawler

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO